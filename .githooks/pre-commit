#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged_py_files=$(git diff --cached --name-only --diff-filter=ACM -- backend/app | grep '\.py$' || true)

if [ -z "$staged_py_files" ]; then
  exit 0
fi

if [ ! -x backend/.venv/bin/ruff ]; then
  echo "error: ruff not found in backend/.venv — run 'make install-backend' first." >&2
  exit 1
fi

if ! backend/.venv/bin/ruff format --check $staged_py_files; then
  echo "" >&2
  echo "error: backend/app is not formatted. Run 'backend/.venv/bin/ruff format backend/app', then re-stage and commit." >&2
  exit 1
fi
